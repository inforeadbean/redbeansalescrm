# Copy this file to .env and fill in real values. Never commit the real .env.

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/rbh_sales_crm
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rbh_sales_crm
MONGO_URI=mongodb://127.0.0.1:27017/rbh_sales_crm

# `npm run dev` runs an embedded in-memory MongoDB for the whole session, so
# no MongoDB install is required. Set USE_MEMORY_DB=true only if you start the
# API with `node server.js` directly and still want a throwaway in-memory DB.
USE_MEMORY_DB=false

# JWT — signs every session. The server refuses to start if this is missing,
# left as the placeholder below, or shorter than 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed to call this API
CLIENT_URL=http://localhost:5173

# The three starting accounts (admin + sales head + sales person), created only
# on an empty boot / `npm run seed:base` (seeding never touches an existing
# account). With NODE_ENV=production the server REFUSES to start while any of
# these is still the `X@123` default — set real values, or once the DB is
# seeded just delete these three lines (unset vars aren't checked).
SEED_ADMIN_EMAIL=admin@redbeanhospitality.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_MANAGER_EMAIL=saleshead@redbeanhospitality.com
SEED_MANAGER_PASSWORD=Head@123
SEED_SALES_EMAIL=sales@redbeanhospitality.com
SEED_SALES_PASSWORD=Sales@123

# Set true to load the bulk demo dataset on an empty boot instead of the base.
SEED_DEMO=false
